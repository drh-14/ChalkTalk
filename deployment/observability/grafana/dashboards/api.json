    {
      "id": 24,
      "title": "Notification fetching latency",
      "type": "timeseries",
      "description": "Completed HTTP requests only. DB query and pool totals sum all instrumented operations during each request, including failed operations and zero-work requests. Concurrent operations may overlap, so totals can exceed HTTP wall-clock latency. Query time is client-observed, not PostgreSQL server time or the HTTP critical path.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{method=\"GET\",route=\"/api/v1/users/me/notifications\",outcome=\"completed\"}[5m])))",
          "refId": "A",
          "legendFormat": "Notification list response P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{method=\"GET\",route=\"/api/v1/users/me/notifications\",outcome=\"completed\"}[5m])))",
          "refId": "B",
          "legendFormat": "Notification list response P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "C",
          "legendFormat": "Notification list total query time P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "D",
          "legendFormat": "Notification list total query time P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_pool_acquire_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "E",
          "legendFormat": "Notification list total connection wait P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_pool_acquire_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "F",
          "legendFormat": "Notification list total connection wait P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{method=\"GET\",route=\"/api/v1/users/me/notifications/unread-count\",outcome=\"completed\"}[5m])))",
          "refId": "G",
          "legendFormat": "Unread count response P50"
