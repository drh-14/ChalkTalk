        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"course_create\",outcome=\"completed\"}[5m])))",
          "refId": "D",
          "legendFormat": "Course creation total query time P95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_pool_acquire_total_duration_seconds_bucket{operation=\"course_create\",outcome=\"completed\"}[5m])))",
          "refId": "E",
          "legendFormat": "Course creation total connection wait P50"
