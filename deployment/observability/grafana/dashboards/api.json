{
  "uid": "chalktalk-api",
  "title": "ChalkTalk API observability",
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests / second",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(chalktalk_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "5xx error fraction",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "(sum(rate(chalktalk_http_requests_total{status_class=\"5xx\",outcome=\"completed\"}[5m])) or vector(0)) / clamp_min(sum(rate(chalktalk_http_requests_total{outcome=\"completed\"}[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "p50 API and database latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{outcome=\"completed\"}[5m])))",
          "refId": "A",
          "legendFormat": "API request"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le, job) (rate(chalktalk_db_query_duration_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "DB query ({{job}})"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le, job) (rate(chalktalk_db_pool_acquire_duration_seconds_bucket[5m])))",
          "refId": "C",
          "legendFormat": "DB pool wait ({{job}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {},
      "description": "Compares independent latency percentiles over the same five-minute window. Client-observed query duration includes transport, PostgreSQL execution, locks, and client queueing. Pool wait measures connection acquisition."
    },
    {
      "id": 4,
      "title": "p95 API and database latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{outcome=\"completed\"}[5m])))",
          "refId": "A",
          "legendFormat": "API request"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(chalktalk_db_query_duration_seconds_bucket[5m])))",
          "refId": "B",
          "legendFormat": "DB query ({{job}})"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(chalktalk_db_pool_acquire_duration_seconds_bucket[5m])))",
          "refId": "C",
          "legendFormat": "DB pool wait ({{job}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {},
      "description": "Compares independent latency percentiles over the same five-minute window. Client-observed query duration includes transport, PostgreSQL execution, locks, and client queueing. Pool wait measures connection acquisition."
    },
    {
      "id": 5,
      "title": "p99 request latency",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{outcome=\"completed\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Within 200 ms",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(chalktalk_http_request_duration_seconds_bucket{le=\"0.2\",outcome=\"completed\"}[5m])) / clamp_min(sum(rate(chalktalk_http_request_duration_seconds_count{outcome=\"completed\"}[5m])), 0.000001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Job outcomes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (kind,outcome) (rate(chalktalk_jobs_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "p95 job duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,kind) (rate(chalktalk_job_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "API, worker, and collaboration scrape health",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=~\"chalktalk-(api|worker|collaboration)\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Definite spool drops / capacity evictions at risk",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(chalktalk_log_spool_dropped_events_total[5m]))",
          "refId": "A"
        },
        {
          "expr": "sum(rate(chalktalk_log_spool_capacity_evicted_events_total[5m]))",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Sanitized API and worker logs",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "loki",
        "uid": "chalktalk-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|worker\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 12,
      "title": "Live session connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 66
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(chalktalk_collaboration_connections)",
          "refId": "A"
        },
        {
          "expr": "sum(chalktalk_collaboration_documents)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "p95 live session store duration",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 66
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_collaboration_store_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Live session closes by reason",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 74
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(chalktalk_collaboration_closes_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {}
    },
    {
      "id": 15,
      "title": "Rejected updates and idle ends",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 74
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(chalktalk_collaboration_rejected_updates_total[5m]))",
          "refId": "A"
        },
        {
          "expr": "sum by (reason) (rate(chalktalk_collaboration_sessions_ended_total[5m]))",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {}
    },
    {
      "id": 20,
      "title": "Database attempts / second",
      "type": "timeseries",
      "description": "Client-observed query attempts plus failed pool acquisitions by API, worker, and collaboration process.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 82
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "(sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m])) or (0 * sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])))) + (sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])) or (0 * sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m]))))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {}
    },
    {
      "id": 21,
      "title": "Failed database attempt fraction",
      "type": "timeseries",
      "description": "Failed queries and failed pool acquisitions divided by query attempts and failed pool acquisitions for each process.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 82
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "((sum by (job) (rate(chalktalk_db_query_duration_seconds_count{outcome=\"failed\"}[5m])) or (0 * sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m]))) or (0 * sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])))) + (sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])) or (0 * sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m]))))) / clamp_min((sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m])) or (0 * sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])))) + (sum by (job) (rate(chalktalk_db_pool_acquire_duration_seconds_count{outcome=\"failed\"}[5m])) or (0 * sum by (job) (rate(chalktalk_db_query_duration_seconds_count[5m])))), 0.000001)",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "options": {}
    },
    {
      "id": 22,
      "title": "Login latency",
      "type": "timeseries",
      "description": "Completed HTTP requests only. DB query and pool totals sum all instrumented operations during each request, including failed operations and zero-work requests. Concurrent operations may overlap, so totals can exceed HTTP wall-clock latency. Query time is client-observed, not PostgreSQL server time or the HTTP critical path.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{method=\"POST\",route=\"/api/v1/sessions\",outcome=\"completed\"}[5m])))",
          "refId": "A",
          "legendFormat": "Login HTTP p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_http_request_duration_seconds_bucket{method=\"POST\",route=\"/api/v1/sessions\",outcome=\"completed\"}[5m])))",
          "refId": "B",
          "legendFormat": "Login HTTP p95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"login\",outcome=\"completed\"}[5m])))",
          "refId": "C",
          "legendFormat": "Login DB query total p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"login\",outcome=\"completed\"}[5m])))",
          "refId": "D",
          "legendFormat": "Login DB query total p95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_pool_acquire_total_duration_seconds_bucket{operation=\"login\",outcome=\"completed\"}[5m])))",
          "refId": "E",
          "legendFormat": "Login DB pool total p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_pool_acquire_total_duration_seconds_bucket{operation=\"login\",outcome=\"completed\"}[5m])))",
          "refId": "F",
          "legendFormat": "Login DB pool total p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "options": {}
    },
