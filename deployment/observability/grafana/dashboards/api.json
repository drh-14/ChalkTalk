      },
      "datasource": {
        "type": "prometheus",
        "uid": "chalktalk-prometheus"
      },
      "targets": [
        {
          "expr": "sum(chalktalk_collaboration_connections)",
          "refId": "A",
          "legendFormat": "Live connections"
        },
        {
          "expr": "sum(chalktalk_collaboration_documents)",
          "refId": "B",
          "legendFormat": "Open documents"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {}
    },
    {
