          "refId": "A",
          "legendFormat": "Lost log events"
        },
        {
          "expr": "sum(rate(chalktalk_log_spool_capacity_evicted_events_total[5m]))",
          "refId": "B",
          "legendFormat": "Evicted log events (delivery uncertain)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Sanitized API and worker logs",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "loki",
        "uid": "chalktalk-logs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|worker\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 12,
      "title": "Live session connections",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
