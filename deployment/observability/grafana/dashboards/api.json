          "refId": "H",
          "legendFormat": "Unread count HTTP p95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_unread_count\",outcome=\"completed\"}[5m])))",
          "refId": "I",
          "legendFormat": "Unread count DB query total p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_unread_count\",outcome=\"completed\"}[5m])))",
          "refId": "J",
