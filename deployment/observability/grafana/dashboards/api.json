          "refId": "B",
          "legendFormat": "Notification list HTTP p95"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "C",
          "legendFormat": "Notification list DB query total p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chalktalk_request_db_query_total_duration_seconds_bucket{operation=\"notifications_list\",outcome=\"completed\"}[5m])))",
          "refId": "D",
          "legendFormat": "Notification list DB query total p95"
