# For standalone manual setup, copy outside the release checkout, fill every placeholder, and chmod 600 before startup. Bootstrapped VMs use /srv/chalktalk/shared/production.env; see README.md.
# The domain's A/AAAA record must point at the VM; inbound TCP 80/443 must be open.
DOMAIN=joinchalktalk.com
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Get the exact direct IPv6 or session-pooler IPv4 URL from Supabase > Connect.
# Replace the 20-character example project ref in the username and Storage endpoint with your own.
# Copy your pooler host from Supabase; URL-encode reserved password characters. Use port 5432 and sslmode=verify-full.
DATABASE_URL=postgresql://postgres.abcdefghijklmnopqrst:replace-with-supabase-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=verify-full

# Create a PRIVATE bucket first. Get these from Supabase Storage > S3 configuration.
# S3 access keys bypass RLS and must never reach the frontend or be committed.
SUPABASE_STORAGE_ENDPOINT=https://abcdefghijklmnopqrst.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=chalktalk-resources
SUPABASE_STORAGE_REGION=us-east-1
SUPABASE_STORAGE_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
SUPABASE_STORAGE_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key

# Resend HTTPS uses ChalkTalk's fixed sender at the verified domain.
RESEND_API_KEY=replace-with-resend-sending-only-key

# Private monitoring token. Bootstrap renders this into production.env.
METRICS_TOKEN=replace-with-at-least-32-random-characters
