# Copy to deployment/production/.env, fill every placeholder, and chmod 600 before startup.
# The domain's A/AAAA record must point at the VM; inbound TCP 80/443 must be open.
DOMAIN=chalktalk.joinchalktalk.com
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Get the exact direct IPv6 or session-pooler IPv4 URL from Supabase > Connect.
# Replace the 20-character example project ref in both URLs with your own.
# URL-encode reserved password characters. Use port 5432 and sslmode=require.
DATABASE_URL=postgresql://postgres:replace-with-supabase-password@db.abcdefghijklmnopqrst.supabase.co:5432/postgres?sslmode=require

# Create a PRIVATE bucket first. Get these from Supabase Storage > S3 configuration.
# S3 access keys bypass RLS and must never reach the frontend or be committed.
S3_ENDPOINT=https://abcdefghijklmnopqrst.storage.supabase.co/storage/v1/s3
S3_BUCKET=chalktalk-resources
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key

# Resend HTTPS; EMAIL_FROM must use your verified sending domain.
EMAIL_FROM="ChalkTalk <noreply@joinchalktalk.com>"
RESEND_API_KEY=replace-with-resend-sending-only-key

OBSERVABILITY_ENABLED=false
