// Managed ChalkTalk security-only origins; preserve unrelated operator policy.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
  "origin=Ubuntu,archive={{ ansible_distribution_release }}-security";
  "origin=UbuntuESMApps,archive={{ ansible_distribution_release }}-apps-security";
  "origin=UbuntuESM,archive={{ ansible_distribution_release }}-infra-security";
};
// Append: never clear operator/distro exclusions.
Unattended-Upgrade::Package-Blacklist {
  "^docker([.-].*)?$";
  "^containerd([.-].*)?$";
  "^runc([.-].*)?$";
};
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Automatic-Reboot-WithUsers "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Remove-New-Unused-Dependencies "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
Unattended-Upgrade::Mail "";
DPkg::Options { "--force-confdef"; "--force-confold"; };
APT::Periodic::Enable "1";
APT::Periodic::Update-Package-Lists "always";
APT::Periodic::Unattended-Upgrade "always";
APT::Periodic::RandomSleep "0";
APT::Periodic::Download-Upgradeable-Packages "0";
APT::Periodic::AutocleanInterval "0";
APT::Periodic::CleanInterval "0";
APT::Update::Error-Mode "any";
