:{$PORT:8080} {
	encode zstd gzip

	@apiHealth path /api/health
	handle @apiHealth {
		rewrite * /health
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
		}
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM} {
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
		}
	}

	handle /collaboration {
		reverse_proxy {$COLLABORATION_UPSTREAM} {
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
