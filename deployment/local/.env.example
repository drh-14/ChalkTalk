DATABASE_URL=postgresql://chalktalk:chalktalk@localhost:5432/chalktalk
# Local development uses PostgreSQL and SeaweedFS; email uses Resend HTTPS.
PORT=3000
AUTH_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
FRONTEND_ORIGINS=https://localhost:5173
FRONTEND_BASE_URL=https://localhost:5173
# Resend uses the fixed verified joinchalktalk.com sender; set its sending-only API key.
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-sending-only-key
# Override only for isolated mocked-network tests; omit for real Resend.
# RESEND_API_BASE_URL=http://127.0.0.1:4000
# Local SeaweedFS S3 credentials. These are not AWS account keys.
# Set your own values in the ignored .env to override the public development defaults.
SEAWEEDFS_ACCESS_KEY_ID=chalktalk-local
SEAWEEDFS_SECRET_ACCESS_KEY=chalktalk-local-secret
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=chalktalk-resources
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=chalktalk-local
S3_SECRET_ACCESS_KEY=chalktalk-local-secret
# Live sessions. Defaults: port 3100, and wss://<FRONTEND_BASE_URL host>/collaboration,
# which the Vite dev server proxies to the collaboration server.
# COLLABORATION_PORT=3100
# COLLABORATION_PUBLIC_URL=wss://localhost:5173/collaboration
# Minutes with nobody connected before a live session ends itself (1 to 10080).
# COLLABORATION_IDLE_END_MINUTES=120
VITE_TLS_KEY_PATH=.cert/localhost-key.pem
VITE_TLS_CERT_PATH=.cert/localhost.pem
MOCK_DATA=false
# Optional deployment-wide semantic post search. Without a key, search stays lexical/fuzzy.
# This sends private post text and search queries to the configured compatible embedding API.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1/
# EMBEDDING_MODEL=text-embedding-3-small
# Set in your ignored .env only when MOCK_DATA=true (12-128 characters).
# AMS161_DEMO_INSTRUCTOR_PASSWORD=
# Optional dedicated Riley Nguyen login (12-128 characters); never resets an existing account.
# AMS161_DEMO_STUDENT_PASSWORD=
# Opt-in local observability (`docker compose --profile app --profile observability up`).
# Set OBSERVABILITY_ENABLED=true and generate independent random hex secrets in ignored .env:
#   openssl rand -hex 32
OBSERVABILITY_ENABLED=false
# METRICS_TOKEN=
# GRAFANA_ADMIN_PASSWORD=
LOG_SPOOL_DIRECTORY=/tmp/chalktalk-logs
GRAFANA_PORT=3001
