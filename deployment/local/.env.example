# Copy to deployment/local/.env; replace secrets before running ./deployment/local/start.sh.
# Literal KEY=value only: no quotes, export, expansion, escapes, or inline comments.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
METRICS_TOKEN=replace-with-a-different-random-secret-of-at-least-32-characters
GRAFANA_ADMIN_PASSWORD=replace-with-a-third-random-secret
DOMAIN=localhost
WEB_PORT=5173
GRAFANA_PORT=3001

LOCAL_DATABASE_ENABLED=true
LOCAL_OBJECT_STORE_ENABLED=true
LOCAL_DATABASE_USER=chalktalk
LOCAL_DATABASE_PASSWORD=chalktalk
LOCAL_DATABASE_NAME=chalktalk
LOCAL_OBJECT_STORE_ACCESS_KEY_ID=chalktalk-local
LOCAL_OBJECT_STORE_SECRET_ACCESS_KEY=chalktalk-local-secret
LOCAL_OBJECT_STORE_BUCKET=chalktalk-resources
LOCAL_OBJECT_STORE_REGION=us-east-1
# Optional loopback-only data ports; absent means unpublished.
# LOCAL_DATABASE_HOST_PORT=15432
# LOCAL_OBJECT_STORE_HOST_PORT=18333

EMAIL_PROVIDER=resend
EMAIL_FROM=ChalkTalk <mail@example.test>
RESEND_API_KEY=replace-with-a-resend-sending-key
# For SendGrid, remove RESEND_* and use EMAIL_PROVIDER=sendgrid + SENDGRID_API_KEY.
# For SES, remove RESEND_* and use EMAIL_PROVIDER=ses plus SES_REGION and
# SES_CREDENTIALS_MODE=explicit with SES_ACCESS_KEY_ID/SES_SECRET_ACCESS_KEY
# (optional SES_SESSION_TOKEN), OR default-chain with an explicit AWS source.

# External connections: ONLY populate when the corresponding LOCAL_*_ENABLED=false.
# DATABASE_URL=postgresql://user:encoded-password@db.example.test:5432/chalktalk?sslmode=verify-full
# S3_ENDPOINT=https://store.example.test/service/path
# S3_BUCKET=existing-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=external-key
# S3_SECRET_ACCESS_KEY=external-secret
# S3_SESSION_TOKEN=optional-temporary-token

# Optional semantic matching; without a key full-text/fuzzy search remains available.
# EMBEDDING_API_KEY=operator-key
# EMBEDDING_BASE_URL=https://api.openai.com/v1/
# EMBEDDING_MODEL=text-embedding-3-small
