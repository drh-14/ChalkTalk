{$DOMAIN}:443 {
	tls internal
	@notApi not path /api/*
	encode @notApi zstd gzip

	@apiHealth path /api/health
	handle @apiHealth {
		rewrite * /health
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /collaboration {
		reverse_proxy collaboration:3100
	}

	handle {
		reverse_proxy web:5173
	}
}
