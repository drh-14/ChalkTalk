# Copy to deployment/.env, edit every placeholder, and chmod 600 before startup.
# The domain's A/AAAA record must point at the VM; inbound TCP 80/443 must be open.
DOMAIN=chalktalk.example.edu

# Use a URL-safe random password here and the SAME password in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-long-random-url-safe-password
DATABASE_URL=postgresql://chalktalk:replace-with-long-random-url-safe-password@postgres:5432/chalktalk
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_SCHOOL_DOMAINS=example.edu

# AWS SES SMTP credentials for the verified sender in the chosen SES region.
# The VM must be allowed to reach the SES SMTP endpoint on port 465.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-ses-smtp-username
SMTP_PASSWORD=replace-with-ses-smtp-password
SMTP_FROM="ChalkTalk <noreply@example.edu>"

# SeaweedFS stays inside the Compose network. These are NOT AWS credentials.
SEAWEEDFS_ACCESS_KEY_ID=replace-with-random-seaweedfs-key
SEAWEEDFS_SECRET_ACCESS_KEY=replace-with-random-seaweedfs-secret
S3_BUCKET=chalktalk-resources
S3_REGION=us-east-1

OBSERVABILITY_ENABLED=false
