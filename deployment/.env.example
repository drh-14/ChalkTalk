# Railway Variables tab template, not a local .env file. Replace every example
# value. Never commit real secrets. See deployment/README.md for which service
# receives each variable and for Railway reference-variable syntax.

# web (only public service)
PORT=8080
API_UPSTREAM=api.railway.internal:3000
COLLABORATION_UPSTREAM=collaboration.railway.internal:3100

# api, worker, collaboration, migrate (as noted in README)
DATABASE_URL=${{Postgres.DATABASE_URL}}
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_SCHOOL_DOMAINS=example.edu
FRONTEND_ORIGINS=https://chalktalk.example.edu
FRONTEND_BASE_URL=https://chalktalk.example.edu
COLLABORATION_PUBLIC_URL=wss://chalktalk.example.edu/collaboration
EMAIL_PROVIDER=resend
EMAIL_FROM=ChalkTalk <noreply@verified.example.edu>
RESEND_API_KEY=re_...replace-with-sending-only-key
S3_ENDPOINT=http://seaweedfs.railway.internal:8333
S3_BUCKET=chalktalk-resources
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-random-seaweedfs-key
S3_SECRET_ACCESS_KEY=replace-with-random-seaweedfs-secret

# api only: one Caddy hop; never assign the API a public domain.
TRUST_PROXY_HOPS=1

# seaweedfs image: use the same credentials as api and worker.
AWS_ACCESS_KEY_ID=replace-with-random-seaweedfs-key
AWS_SECRET_ACCESS_KEY=replace-with-random-seaweedfs-secret

# Optional on api, worker, collaboration, migrate if not already defaulted.
OBSERVABILITY_ENABLED=false
