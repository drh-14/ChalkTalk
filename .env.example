DATABASE_URL=postgresql://chalktalk:chalktalk@localhost:5432/chalktalk
PORT=3000
AUTH_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
FRONTEND_ORIGINS=https://localhost:5173
FRONTEND_BASE_URL=https://localhost:5173
ALLOWED_SCHOOL_DOMAINS=example.edu
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ChalkTalk <noreply@chalktalk.local>
RATE_LIMIT_VERIFICATION_EMAIL=5
RATE_LIMIT_VERIFICATION_IP=100
RATE_LIMIT_LOGIN_EMAIL=10
RATE_LIMIT_LOGIN_IP=100
RATE_LIMIT_RESET_EMAIL=5
RATE_LIMIT_RESET_IP=100
RATE_LIMIT_SIGNUP_IP=100
VITE_TLS_KEY_PATH=.cert/localhost-key.pem
VITE_TLS_CERT_PATH=.cert/localhost.pem
