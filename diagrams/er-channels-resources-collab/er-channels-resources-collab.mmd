erDiagram
  courses ||--o{ channels : "contains"
  channels ||--o{ subchannels : "contains"
  subchannels ||--o{ messages : "contains"
  courses ||--o{ resources : "has"
  resources ||--o{ resource_regions : "divided into"
  courses ||--o{ collaboration_sessions : "hosts"
  collaboration_sessions ||--|| collaboration_documents : "edits"
  collaboration_sessions ||--o{ collaboration_tickets : "issues"
  sessions ||--o{ collaboration_tickets : "binds"

  courses {
    uuid id PK
  }
  sessions {
    uuid id PK
  }
  channels {
    uuid id PK
    uuid course_id FK
  }
  subchannels {
    uuid id PK
    uuid course_id FK
    uuid channel_id FK
  }
  messages {
    uuid id PK
    uuid course_id FK
    uuid subchannel_id FK
  }
  resources {
    uuid id PK
    uuid course_id FK
  }
  resource_regions {
    uuid id PK
    uuid course_id FK
    uuid resource_id FK
  }
  collaboration_sessions {
    uuid id PK
    uuid course_id FK
    uuid post_id FK
    uuid subchannel_id FK
  }
  collaboration_documents {
    uuid id PK
    uuid session_id FK
  }
  collaboration_tickets {
    uuid id PK
    uuid session_id FK
    uuid auth_session_id FK
  }
  jobs {
    uuid id PK
    text status
  }
