%% Run python3 diagrams/architecture/render.py to regenerate matching exports.
flowchart TB
    Frontend["Frontend (Docker / Vercel)<br/>React + Vite"]

    subgraph Backend["Backend (Docker / AWS ECS)"]
        direction LR
        WebServer["Web server<br/>Express.js HTTP API"]
        CollaborationEngine["Collaboration engine<br/>Yjs + Hocuspocus"]
        Worker["Worker<br/>Node.js process"]
    end

    ApplicationDatabase["Application Database<br/>PostgreSQL / AWS RDS"]
    ObjectStore["Object Store<br/>SeaweedFS / AWS S3"]
    EmailProvider["Email Provider<br/>SMTP Server / AWS SES"]

    Frontend -- "HTTPS (REST)" --> WebServer
    Frontend -- "WebSocket" --> CollaborationEngine
    CollaborationEngine -- "load/save Yjs<br/>documents" --> ApplicationDatabase
    WebServer -- "read/write data<br/>queue jobs" --> ApplicationDatabase
    WebServer -- "upload/fetch files" --> ObjectStore
    Worker -- "claim jobs<br/>update data" --> ApplicationDatabase
    Worker -- "read files<br/>for OCR" --> ObjectStore
    Worker -- "send emails" --> EmailProvider

    classDef client fill:#DBEAFE,stroke:#2563EB,color:#1E3A8A,stroke-width:1.5px
    classDef compute fill:#FFEDD5,stroke:#EA580C,color:#7C2D12,stroke-width:1.5px
    classDef database fill:#F3E8FF,stroke:#9333EA,color:#581C87,stroke-width:1.5px
    classDef storage fill:#DCFCE7,stroke:#16A34A,color:#14532D,stroke-width:1.5px
    classDef external fill:#F1F5F9,stroke:#64748B,color:#334155,stroke-width:1.5px
    class Frontend client
    class CollaborationEngine,WebServer,Worker compute
    class ApplicationDatabase database
    class ObjectStore storage
    class EmailProvider external
    style Backend fill:#F8FAFC,stroke:#94A3B8,color:#0F172A,stroke-width:1.5px
