{
  "name": "chalktalk",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@chalktalk/web && npm run build --workspace=@chalktalk/api",
    "dev": "concurrently -n web,api,worker,collab -c cyan,green,yellow,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:collab\"",
    "dev:web": "npm run dev --workspace=@chalktalk/web",
    "dev:api": "npm run dev --workspace=@chalktalk/api",
    "dev:worker": "npm run dev:worker --workspace=@chalktalk/api",
    "dev:collab": "npm run dev:collab --workspace=@chalktalk/api",
    "db:migrate": "npm run migrate --workspace=@chalktalk/api",
    "db:import:piazza": "npm run import:piazza --workspace=@chalktalk/api --",
    "format": "prettier --write \"apps/**/*.{css,html,json,ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{css,html,json,ts,tsx}\" \".github/**/*.{yml,yaml}\" \"*.{js,json,md,yml,yaml}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:email:live": "node --import tsx tests/live/resend.live.ts",
    "test:browser:answers": "playwright test tests/browser/answer-save-only.spec.mjs --workers=1",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.app.json && tsc --noEmit -p apps/api/tsconfig.json",
    "test:browser:attachments": "playwright test tests/browser/attachments.spec.mjs --workers=1",
    "test:browser:live-sessions": "playwright test tests/browser/live-code-session.spec.mjs tests/browser/live-whiteboard.spec.mjs tests/browser/live-session-invitations.spec.mjs tests/browser/live-session-viewers.spec.mjs --workers=1",
    "test:browser:course-files": "playwright test tests/browser/course-files.spec.mjs --workers=1",
    "test:browser:resource-search": "playwright test tests/browser/resource-text-search.spec.mjs --workers=1",
    "test:browser:mocked": "playwright test tests/browser/course-collaboration.spec.mjs tests/browser/course-pages.spec.mjs tests/browser/course-destructive-confirmations.spec.mjs tests/browser/course-email-preferences.spec.mjs tests/browser/course-information.spec.mjs tests/browser/discussion-layout.spec.mjs tests/browser/discussion-locks.spec.mjs tests/browser/markdown-tables.spec.mjs tests/browser/notification-bell-cards.spec.mjs tests/browser/organized-resources.spec.mjs tests/browser/post-delete.spec.mjs tests/browser/post-drafts.spec.mjs tests/browser/resource-extracted-text.spec.mjs tests/browser/resource-extraction-progress.spec.mjs tests/browser/response-email-links.spec.mjs tests/browser/signup-email.spec.mjs --workers=1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@hocuspocus/provider": "^4.7.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "supabase": "3.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "lodash-es": "4.18.1",
    "katex": "0.18.9",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
